# OpenDART API 키 (https://opendart.fss.or.kr/intro/main.do)
OPENDART_API_KEY=your_opendart_api_key_here

# Google Gemini API 키 (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# KIPRIS 특허검색 키 — 기술 추적(기술 → 특허 → 기업)에만 쓴다. 비우면 스캔이 막힌다.
# **data.go.kr에서 발급받은 ServiceKey여야 한다.** KIPRIS Plus 가입으로 받는 accessKey는
# 게이트웨이가 달라(/openapi/rest/) 여기 넣으면 INVALID_REQUEST_PARAMETER_ERROR가 난다.
#   발급: https://www.data.go.kr → "특허실용신안정보 검색서비스" 활용신청
#   상품별로 따로 신청해야 하며, 미신청 상태면 code=30이 돌아온다
# 무료 한도가 월 1,000회뿐이라 호출 전에 api_usage가 잔여를 확인하고 막는다.
KIPRIS_API_KEY=your_kipris_service_key_here

# 데이터 저장 경로
# 로컬 개발: ./data  |  Docker: /app/data (기본값)
DATA_DIR=./data

# 서버 포트
BACKEND_PORT=8016
FRONTEND_PORT=8116

# 스케줄러: 신규 사업보고서 자동 수집 주기 (시간)
SCHEDULER_INTERVAL_HOURS=24

# batch 작업 상태 확인 주기 (초). 실측 turnaround는 8분 안팎
BATCH_POLL_INTERVAL_SECS=60

# 기술 추적: 등록한 기술의 특허를 다시 검색하는 주기 (일)
# 특허는 출원 후 18개월 뒤에 공개되므로 월 1회면 충분하다 — 주 1회는 과잉이고,
# 월 1회면 기술 100개까지 KIPRIS 월 한도의 50%다
TECH_SCAN_INTERVAL_DAYS=30
TECH_SCAN_ENABLED=true

# 아래 두 값은 최초 기본값일 뿐이다 — 설정 화면에서 재시작 없이 바꿀 수 있고,
# 한 번 바꾸면 DB 값이 우선한다.

# 신규 보고서 수집 후 분석까지 자동 요청할지 (true/false)
SCHEDULER_AUTO_ANALYZE=false

# 보고서에서 분석에 필요한 구역만 추려 LLM에 전달 (입력 ~87% 절감)
# 추출에 실패하면 LLM에 보내지 않고 화면에 알린다
SECTION_EXTRACT_ENABLED=true

# 관리자 키 — 설정 시 삭제·분석 등 관리 기능에 X-Admin-Key 헤더 필요
# 비워두면 인증 비활성화(모든 요청 허용, 개발용)
ADMIN_KEY=
