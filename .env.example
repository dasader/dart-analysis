# OpenDART API 키 (https://opendart.fss.or.kr/intro/main.do)
OPENDART_API_KEY=your_opendart_api_key_here

# Google Gemini API 키 (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 데이터 저장 경로
# 로컬 개발: ./data  |  Docker: /app/data (기본값)
DATA_DIR=./data

# 서버 포트
BACKEND_PORT=8016
FRONTEND_PORT=8116

# 스케줄러: 신규 사업보고서 자동 수집 주기 (시간)
SCHEDULER_INTERVAL_HOURS=24

# batch 작업 상태 확인 주기 (초). 실측 turnaround는 8분 안팎
BATCH_POLL_INTERVAL_SECS=60

# 신규 보고서 수집 후 분석까지 자동 요청할지 (true/false)
# 기본 false — 켜면 스케줄러가 수집한 보고서를 자동으로 batch 분석에 올린다
SCHEDULER_AUTO_ANALYZE=false

# 관리자 키 — 설정 시 삭제·분석 등 관리 기능에 X-Admin-Key 헤더 필요
# 비워두면 인증 비활성화(모든 요청 허용, 개발용)
ADMIN_KEY=
